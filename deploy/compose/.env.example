# Copy to .env and replace every REPLACE_* value before starting Compose.
TOKENSEA_ENV=prod
TOKENSEA_CONSOLE_PORT=39210
TOKENSEA_CONTROL_PORT=39211
TOKENSEA_GATEWAY_PORT=39212
TOKENSEA_POSTGRES_PORT=39213
TOKENSEA_REDIS_PORT=39214
TOKENSEA_PROMETHEUS_PORT=39215
TOKENSEA_GRAFANA_PORT=39216
TOKENSEA_RUNTIME_CORE_PORT=39218
TOKENSEA_HEADLESS_FETCHER_PORT=39219

TOKENSEA_DB_NAME=tokensea
TOKENSEA_DB_USER=tokensea
TOKENSEA_DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
TOKENSEA_REDIS_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_REDIS_PASSWORD
TOKENSEA_DB_URL=jdbc:postgresql://tokensea-postgres:5432/tokensea
TOKENSEA_JWT_SECRET=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_BYTES
TOKENSEA_CRYPTO_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY
TOKENSEA_RUNTIME_CORE_KEY=REPLACE_WITH_RANDOM_RUNTIME_MASTER_KEY
TOKENSEA_EGRESS_POLICY_TOKEN=REPLACE_WITH_RANDOM_INTERNAL_EGRESS_POLICY_TOKEN
TOKENSEA_BOOTSTRAP_TOKEN=REPLACE_WITH_ONE_TIME_RANDOM_BOOTSTRAP_TOKEN
TOKENSEA_BUDGET_CURRENCY=CNY
# 汇率自动更新：每月 1 日北京时间 03:10 同步，缺失时每日 03:40 重试；价格明细保留原币种，汇总统一折算为 CNY。
TOKENSEA_FX_SOURCE_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml
TOKENSEA_FX_MANAGED_CURRENCIES=USD
TOKENSEA_FX_MONTHLY_CRON="0 10 3 1 * *"
TOKENSEA_FX_RECOVERY_CRON="0 40 3 * * *"
TOKENSEA_FX_ZONE=Asia/Shanghai
# Successful manual connection tests remain valid for publishing/routing for 7 days by default.
TOKENSEA_CONNECTION_TEST_VALID_MINUTES=10080
TOKENSEA_CONNECTION_TEST_MAX_AGE_SECONDS=604800
# Gateway re-resolves provider DNS at this interval; public CDN address rotation is accepted automatically.
TOKENSEA_DNS_RECHECK_TTL_SECONDS=300
TOKENSEA_RUNTIME_CORE_IMAGE=ghcr.io/berriai/litellm:v1.91.0

# Comma-separated browser origins. Wildcards are intentionally unsupported.
TOKENSEA_CORS_ALLOWED_ORIGINS=http://localhost:39210
# Common fixed API hosts from TokenSea's built-in provider catalog are pre-allowed here.
# Keep exact comma-separated hostnames only; protocols, paths, ports and wildcards are unsupported.
# Resource-specific, regional, private and custom endpoints must still be reviewed and appended explicitly.
TOKENSEA_ALLOWED_EGRESS_HOSTS=api.openai.com,api.anthropic.com,generativelanguage.googleapis.com,api.deepseek.com,dashscope.aliyuncs.com,open.bigmodel.cn,ark.cn-beijing.volces.com,qianfan.baidubce.com,spark-api-open.xf-yun.com,api.hunyuan.cloud.tencent.com,api.moonshot.cn,api.minimax.chat,api.minimaxi.com,api.siliconflow.cn,api.mistral.ai,api.cohere.com,api.groq.com,api.together.xyz,api.perplexity.ai,api.x.ai,api.xiaomimimo.com,token-plan-cn.xiaomimimo.com,prices.azure.com,pricing.us-east-1.amazonaws.com,cloudbilling.googleapis.com,raw.githubusercontent.com,models.dev
# Add non-standard provider TLS/HTTP ports explicitly when required.
TOKENSEA_EGRESS_ALLOWED_PORTS=80,443
# Price-source official hosts are loaded dynamically from the control plane after administrator approval.
TOKENSEA_EGRESS_POLICY_REFRESH_SECONDS=15

# Optional LLM-backed mapping for generic HTML/CSV/JSON/PDF pricing documents. Disabled by default.
# The configured endpoint must be OpenAI-compatible and must not share a normal tenant Virtual Key.
TOKENSEA_PRICE_DOCUMENT_LLM_ENABLED=false
TOKENSEA_PRICE_DOCUMENT_LLM_URL=
TOKENSEA_PRICE_DOCUMENT_LLM_MODEL=
TOKENSEA_PRICE_DOCUMENT_LLM_API_KEY=
TOKENSEA_PRICE_DOCUMENT_LLM_MAX_CHARS=60000
TOKENSEA_PROVIDER_BILLING_SCHEDULER_MS=300000

# Local OpenAI-compatible upstreams are disabled by default. Enable only in an isolated development environment,
# list exact test hostnames, add their ports to TOKENSEA_EGRESS_ALLOWED_PORTS, and keep production set to false.
TOKENSEA_LOCAL_TEST_UPSTREAM_ENABLED=false
TOKENSEA_LOCAL_TEST_UPSTREAM_HOSTS=
# Optional comma-prefixed additions to Runtime Core NO_PROXY, for example: ,host.docker.internal
TOKENSEA_RUNTIME_NO_PROXY_EXTRA=
